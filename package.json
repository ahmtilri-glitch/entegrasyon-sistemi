{
  "name": "tgo-entegrasyon-sistemi",
  "version": "1.0.0",
  "private": true,
  "description": "Trendyol Go (Yemek & Market) yonetim paneli backend entegrasyonu",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "dev": "tsx watch src/api/server.ts",
    "worker": "tsx src/workers/main.ts",
    "start:worker": "node dist/workers/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "mysql2": "3.11.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.9",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "eslint": "8.57.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}

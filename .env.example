# ---- TGO API ----
# PROD | STAGE
TGO_ENVIRONMENT=STAGE
TGO_SUPPLIER_ID=123456
TGO_API_KEY=
TGO_API_SECRET=
# Entegrator ismi: alfanumerik, max 30 karakter. User-Agent "{supplierId} - {IntegratorName}" olarak uretilir.
TGO_INTEGRATOR_NAME=SelfIntegration
# x-executor-user header'i icin islemi yapan kisinin e-postasi
TGO_EXECUTOR_USER=entegrasyon@ornek.com
TGO_TIMEOUT_MS=30000
TGO_MAX_RETRIES=3
TGO_RETRY_BASE_DELAY_MS=500
# Ayni endpoint icin 10 saniyede maksimum 50 istek
TGO_RATE_LIMIT_PER_10S=50

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tgo
DB_PASSWORD=
DB_NAME=tgo_panel
DB_CONNECTION_LIMIT=10

# ---- HTTP sunucu ----
PORT=3000
LOG_LEVEL=info
# Webhook Basic Auth kimlik bilgileri (TGO tarafina bildirilen)
WEBHOOK_BASIC_USER=tgo
WEBHOOK_BASIC_PASSWORD=
# Panel REST API icin statik API anahtari
PANEL_API_KEY=

# ---- Polling worker ----
POLL_ENABLED=true
POLL_INTERVAL_MS=30000
POLL_LOOKBACK_MS=3600000
POLL_MEAL_STORE_IDS=
POLL_GROCERY_STORE_IDS=
